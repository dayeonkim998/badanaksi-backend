# Railway 환경변수 설정 예시
# Railway 대시보드 → 프로젝트 → Variables 에서 아래 값들을 하나씩 추가

# ── 데이터베이스 (Supabase PostgreSQL) ────────────────────────
# Supabase → Settings → Database → Connection string (Transaction mode / port 6543)
DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# ── AI ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── 인증 ──────────────────────────────────────────────────────
JWT_SECRET=your_very_long_random_secret_32chars
JWT_REFRESH_SECRET=another_very_long_random_secret

# ── 관리자 계정 ───────────────────────────────────────────────
ADMIN_EMAIL=admin@badanaksi.app
ADMIN_PASSWORD=strong_password_here

# ── 날씨 API ──────────────────────────────────────────────────
KMA_API_KEY=your_kma_service_key
TIDE_API_KEY=your_tide_api_key
OPENWEATHER_API_KEY=your_openweather_key

# ── 사진 저장 (Cloudflare R2) ─────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_r2_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET_NAME=badanaksi-photos
R2_PUBLIC_URL=https://pub-XXXX.r2.dev

# ── 제휴 수익화 ───────────────────────────────────────────────
COUPANG_ACCESS_KEY=your_coupang_key
COUPANG_SECRET_KEY=your_coupang_secret
COUPANG_PARTNERS_ID=your_partners_id
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# ── NIFS 해양 데이터 (없으면 mock 사용) ──────────────────────
NIFS_FISHING_GROUND_API_KEY=
NIFS_COASTAL_OBS_API_KEY=
